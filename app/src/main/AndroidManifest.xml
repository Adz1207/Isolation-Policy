<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Dibutuhkan agar daftar aplikasi terpasang bisa dibaca (Android 11+) -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

    <!--
        Modul libxposed API 101+ tidak lagi memakai meta-data xposedmodule/xposeddescription.
        Metadata modul ada di META-INF/xposed/{module.prop,scope.list,java_init.list},
        nama dari android:label dan deskripsi dari android:description.
        Provider XposedProvider otomatis ikut dari library io.github.libxposed:service.
    -->
    <application
        android:name=".App"
        android:allowBackup="true"
        android:description="@string/app_description"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar"
        android:zygotePreloadName="io.github.mhmrdd.isolationpolicy.AppZygote">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Service tester: harus isolated + App Zygote supaya hook bisa diuji -->
        <service
            android:name=".IsolationPolicyService"
            android:exported="false"
            android:isolatedProcess="true"
            android:useAppZygote="true" />

    </application>
</manifest>
